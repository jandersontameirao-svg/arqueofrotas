# ArqueoFrotas — variáveis de ambiente (produção VPS)
# Copie para .env e preencha. NUNCA comite o .env real.

# --- Banco de dados (obrigatório) ---
DATABASE_URL=mysql://arqueofrotas:SENHA_FORTE_AQUI@127.0.0.1:3306/arqueofrotas

# --- Sessão / segurança (obrigatório) ---
# Gere com: openssl rand -hex 32
JWT_SECRET=

# --- App ---
VITE_APP_ID=arqueofrotas
NODE_ENV=production
PORT=8001
HOST=127.0.0.1
# URL pública, usada em links de email:
APP_BASE_URL=https://arqueofrotas.sigpa.com.br

# --- OpenAI (cadastro por IA / login) — opcional ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-6-luna

# --- Email (opcional) ---
# Ordem de preferência: Resend API -> SMTP -> desativado. Se nada for
# preenchido, o email não é enviado e só o painel de notificações funciona.
#
# Remetente (usado pelos dois caminhos). No Resend precisa ser de um domínio
# VERIFICADO no painel (ou onboarding@resend.dev só para teste).
MAIL_FROM=ArqueoFrotas <no-reply@grupoarqueo.com.br>

# Opção A (RECOMENDADA) — Resend API. Cole a chave re_... do painel do Resend:
RESEND_API_KEY=

# Opção B — SMTP (só use se NÃO preencher o Resend acima):
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
