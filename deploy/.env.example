# ===== ArqueoFrotas — variáveis de ambiente (produção) =====
# Copie para a RAIZ do projeto como `.env` e preencha os valores reais.
# As variáveis VITE_* são embutidas no bundle DURANTE o `pnpm build`,
# então o .env precisa existir ANTES de buildar.

# Ambiente
NODE_ENV=production

# Porta/host locais (nginx faz o proxy; manter em 127.0.0.1)
PORT=8001
HOST=127.0.0.1

# Banco de dados MySQL local
# Formato: mysql://USUARIO:SENHA@127.0.0.1:3306/NOME_DO_BANCO
DATABASE_URL=mysql://arqueofrotas:TROQUE_ESTA_SENHA@127.0.0.1:3306/arqueofrotas

# Segredo para assinar a sessão (JWT HS256). Gere um valor longo e aleatório:
#   openssl rand -hex 32
JWT_SECRET=TROQUE_POR_UM_VALOR_ALEATORIO_LONGO

# Identificador do app (preenche o campo appId da sessão). Pode ser fixo.
VITE_APP_ID=arqueofrotas

# ---------------------------------------------------------------------------
# As variáveis abaixo pertenciam ao OAuth da Manus e NÃO são mais necessárias
# após a migração para login próprio. Deixadas aqui apenas como referência:
# OAUTH_SERVER_URL=
# VITE_OAUTH_PORTAL_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
